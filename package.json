{
  "name": "UniversalMediaStudio",
  "version": "1.0.0",
  "description": "Desktop media player & manager powered by ADAUMC format",
  "main": "./out/main/index.js",
  "author": "Aluri Dev Ananth",
  "license": "MIT",
  "build": {
    "appId": "com.adaumc.universalmediastudio",
    "productName": "UniversalMediaStudio",
    "win": {
      "icon": "resources/icon.ico",
      "target": ["nsis", "portable"]
    },
    "fileAssociations": [
      {
        "ext": "adaumc",
        "name": "ADAUMC Media Bundle",
        "icon": "resources/icon.ico",
        "role": "Viewer",
        "isPackage": true
      }
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "node node_modules/electron/install.js",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "bun test",
    "benchmark": "bun run scripts/benchmark.ts",
    "startup": "bun run scripts/startup.ts",
    "packagecode": "bun run scripts/package-code.ts"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@vidstack/react": "^1.12.13",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.5.4",
    "electron": "^43.4.1",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.14.0",
    "ignore": "^7.0.6",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
